// Copy to Secrets.xcconfig (git-ignored) and fill in from the Google Cloud console.
// An iOS OAuth client ID is not a secret in the cryptographic sense (it ships in the app),
// but keeping it out of git keeps the repo shareable and the project ID private.

// Optional: set your Team ID here instead of in Base.xcconfig
// DEVELOPMENT_TEAM = ABCDE12345

GOOGLE_CLIENT_ID = 123456789012-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.123456789012-abcdefghijklmnop
