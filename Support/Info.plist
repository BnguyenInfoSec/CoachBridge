<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).daily-export</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CBAppGroup</key>
	<string>group.$(BUNDLE_ID_PREFIX).CoachBridge</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Coach Bridge</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>FIT activity</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.garmin.fit</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-oauth-redirect</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GIDClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Coach Bridge reads your calendars so training fits around your schedule, and adds your planned sessions to a separate Training calendar. When you refresh the Plan tab, event times and titles for the next week are sent to Anthropic's Claude API so it can plan around them. Locations, notes and attendees are never read or sent.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Coach Bridge reads your resting heart rate, HRV, sleep, respiratory rate, wrist temperature, blood oxygen, VO2 max, heart-rate recovery, walking heart rate, weight, body fat, activity totals, workouts (with heart rate, power, cadence and distance) and running form metrics. It shows them on your dashboard and once a day saves a summary to a Coach folder in your own Google Drive. If you use the in-app Coach chat with Health sharing on, a summary is sent to Anthropic's Claude API with your message. Nothing is sent anywhere else.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Coach Bridge uses your approximate location, once, to set where your training forecast comes from. Only rounded coordinates are sent to the weather service; your location isn't tracked.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>healthkit</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
